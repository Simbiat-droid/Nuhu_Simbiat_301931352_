PART 5 - READ COMMITTED vs REPEATABLE READ
==========================================================================
[reset] UPDATE fine SET amount=1500.00 WHERE fine_id=(SELECT f.fine_id FROM fine f JOIN loan l ON l.loan_id=f.loan_id WHERE l.member_id=9301 LIMIT 1)
[reset]   -> UPDATE 1
-- 5a READ COMMITTED: A reads, B updates + commits, A reads again --
[Terminal A] BEGIN ISOLATION LEVEL READ COMMITTED
[Terminal A]   -> BEGIN
[Terminal A] SELECT amount FROM fine WHERE fine_id=(SELECT f.fine_id FROM fine f JOIN loan l ON l.loan_id=f.loan_id WHERE l.member_id=9301 LIMIT 1)
[Terminal A]   -> ['amount']: [(Decimal('1500.00'),)]
[Terminal B] UPDATE fine SET amount = 2000.00 WHERE fine_id=(SELECT f.fine_id FROM fine f JOIN loan l ON l.loan_id=f.loan_id WHERE l.member_id=9301 LIMIT 1)
[Terminal B]   -> UPDATE 1
[Terminal A] SELECT amount FROM fine WHERE fine_id=(SELECT f.fine_id FROM fine f JOIN loan l ON l.loan_id=f.loan_id WHERE l.member_id=9301 LIMIT 1)
[Terminal A]   -> ['amount']: [(Decimal('2000.00'),)]
[Terminal A] COMMIT
[Terminal A]   -> COMMIT
RESULT 5a: first read 1500.00, second read 2000.00 inside ONE transaction -> non-repeatable read
[reset] UPDATE fine SET amount=1500.00 WHERE fine_id=(SELECT f.fine_id FROM fine f JOIN loan l ON l.loan_id=f.loan_id WHERE l.member_id=9301 LIMIT 1)
[reset]   -> UPDATE 1
-- 5b REPEATABLE READ: same steps --
[Terminal A] BEGIN ISOLATION LEVEL REPEATABLE READ
[Terminal A]   -> BEGIN
[Terminal A] SELECT amount FROM fine WHERE fine_id=(SELECT f.fine_id FROM fine f JOIN loan l ON l.loan_id=f.loan_id WHERE l.member_id=9301 LIMIT 1)
[Terminal A]   -> ['amount']: [(Decimal('1500.00'),)]
[Terminal B] UPDATE fine SET amount = 2000.00 WHERE fine_id=(SELECT f.fine_id FROM fine f JOIN loan l ON l.loan_id=f.loan_id WHERE l.member_id=9301 LIMIT 1)
[Terminal B]   -> UPDATE 1
[Terminal A] SELECT amount FROM fine WHERE fine_id=(SELECT f.fine_id FROM fine f JOIN loan l ON l.loan_id=f.loan_id WHERE l.member_id=9301 LIMIT 1)
[Terminal A]   -> ['amount']: [(Decimal('1500.00'),)]
[Terminal A] COMMIT
[Terminal A]   -> COMMIT
[Terminal A] SELECT amount FROM fine WHERE fine_id=(SELECT f.fine_id FROM fine f JOIN loan l ON l.loan_id=f.loan_id WHERE l.member_id=9301 LIMIT 1)
[Terminal A]   -> ['amount']: [(Decimal('2000.00'),)]
RESULT 5b: reads inside the transaction 1500.00 and 1500.00 (snapshot), after COMMIT 2000.00
-- 5c REPEATABLE READ hides a phantom: B inserts an active loan for member 9301 --
[Terminal A] BEGIN ISOLATION LEVEL REPEATABLE READ
[Terminal A]   -> BEGIN
[Terminal A] SELECT count(*) AS active_loans FROM loan WHERE member_id=9301 AND return_date IS NULL
[Terminal A]   -> ['active_loans']: [(0,)]
[Terminal B] INSERT INTO loan (copy_id,member_id,loan_date,due_date) VALUES (9301,9301,NOW(),NULL)
[Terminal B]   -> INSERT 0 1
[Terminal A] SELECT count(*) AS active_loans FROM loan WHERE member_id=9301 AND return_date IS NULL
[Terminal A]   -> ['active_loans']: [(0,)]
[Terminal A] COMMIT
[Terminal A]   -> COMMIT
[Terminal A] SELECT count(*) AS active_loans FROM loan WHERE member_id=9301 AND return_date IS NULL
[Terminal A]   -> ['active_loans']: [(1,)]
RESULT 5c: inside REPEATABLE READ 0 then 0 (phantom hidden); new snapshot 1
[reset] DELETE FROM loan WHERE member_id=9301 AND return_date IS NULL
[reset]   -> DELETE 1
[reset] UPDATE fine SET amount=1500.00 WHERE fine_id=(SELECT f.fine_id FROM fine f JOIN loan l ON l.loan_id=f.loan_id WHERE l.member_id=9301 LIMIT 1)
[reset]   -> UPDATE 1

