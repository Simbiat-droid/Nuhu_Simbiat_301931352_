PART 1 - THE BUG: check-then-insert with NO constraint (loan_naive)
loan_naive is a copy of loan's columns WITHOUT the EXCLUDE constraint,
i.e. what the database would allow if Portfolio 1 had not added it.
==========================================================================
[setup] CREATE TABLE loan_naive (LIKE loan INCLUDING DEFAULTS)
[setup]   -> CREATE TABLE
[Terminal A] BEGIN
[Terminal A]   -> BEGIN
[Terminal A] SELECT count(*) AS active_loans_on_9101 FROM loan_naive WHERE copy_id=9101 AND return_date IS NULL
[Terminal A]   -> ['active_loans_on_9101']: [(0,)]
[Terminal B] BEGIN
[Terminal B]   -> BEGIN
[Terminal B] SELECT count(*) AS active_loans_on_9101 FROM loan_naive WHERE copy_id=9101 AND return_date IS NULL
[Terminal B]   -> ['active_loans_on_9101']: [(0,)]
-- both sessions saw 0 active loans, so both 'decide' the copy is free --
[Terminal A] INSERT INTO loan_naive (copy_id,member_id,loan_date,due_date,loan_range) VALUES (9101,9101,NOW(),NOW()+INTERVAL '14 days',tstzrange(NOW(),NOW()+INTERVAL '14 days'))
[Terminal A]   -> INSERT 0 1
[Terminal A] COMMIT
[Terminal A]   -> COMMIT
[Terminal B] INSERT INTO loan_naive (copy_id,member_id,loan_date,due_date,loan_range) VALUES (9101,9102,NOW(),NOW()+INTERVAL '14 days',tstzrange(NOW(),NOW()+INTERVAL '14 days'))
[Terminal B]   -> INSERT 0 1
[Terminal B] COMMIT
[Terminal B]   -> COMMIT
[check] SELECT copy_id, member_id, loan_range FROM loan_naive WHERE copy_id=9101 ORDER BY member_id
[check]   -> ['copy_id', 'member_id', 'loan_range']: [(9101, 9101, DateTimeTZRange(datetime.datetime(2026, 11, 11, 18, 28, 11, 445607, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 11, 25, 18, 28, 11, 445607, tzinfo=datetime.timezone.utc), '[)')), (9101, 9102, DateTimeTZRange(datetime.datetime(2026, 11, 11, 18, 28, 11, 446061, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 11, 25, 18, 28, 11, 446061, tzinfo=datetime.timezone.utc), '[)'))]
RESULT PART 1: 2 overlapping loans of ONE physical copy -> BUG REPRODUCED (lost update / double booking)
[cleanup] DROP TABLE loan_naive
[cleanup]   -> DROP TABLE

