PART 3 - FIX 2: borrow_copy() uses SELECT ... FOR UPDATE
B waits for A, re-checks the row, finds it on_loan and is RESERVED instead
==========================================================================
[reset] DELETE FROM loan WHERE member_id IN (9101,9102)
[reset]   -> DELETE 1
[reset] DELETE FROM reservation WHERE member_id IN (9101,9102)
[reset]   -> DELETE 0
[reset] UPDATE copy SET status='available' WHERE copy_id=9101
[reset]   -> UPDATE 1
[Terminal A] BEGIN
[Terminal A]   -> BEGIN
[Terminal A] SELECT borrow_copy(9101, 9101, 9101) AS copy_borrowed
[Terminal A]   -> ['copy_borrowed']: [(9101,)]
[Terminal B] BEGIN
[Terminal B]   -> BEGIN
[Terminal B] SELECT borrow_copy(9102, 9101, 9101) AS copy_borrowed
[Terminal B] (still running after 1.5 s: True)
[observer] SELECT application_name, state, wait_event_type, wait_event FROM pg_stat_activity WHERE application_name = %s
[observer]   -> ['application_name', 'state', 'wait_event_type', 'wait_event']: [('Terminal B', 'active', 'Lock', 'transactionid')]
[observer] => Terminal B is BLOCKED, waiting for a lock held by the other session
[Terminal A] COMMIT
[Terminal A]   -> COMMIT
[Terminal B]   -> ['copy_borrowed']: [(None,)]
[Terminal B] waited 1.50 s, borrow_copy returned [(None,)] (NULL = no copy left, a reservation was created)
[Terminal B] COMMIT
[Terminal B]   -> COMMIT
[check] SELECT member_id, book_id, branch_id, fulfilled_at FROM reservation WHERE member_id=9102
[check]   -> ['member_id', 'book_id', 'branch_id', 'fulfilled_at']: [(9102, 9101, 9101, None)]
[check] SELECT copy_id, status FROM copy WHERE copy_id=9101
[check]   -> ['copy_id', 'status']: [(9101, 'on_loan')]
[check] SELECT member_id, copy_id FROM loan WHERE copy_id=9101 AND return_date IS NULL
[check]   -> ['member_id', 'copy_id']: [(9101, 9101)]
RESULT PART 3: A got the copy, B got a reservation - no error, no double loan

